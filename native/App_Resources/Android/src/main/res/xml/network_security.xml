<?xml version="1.0" encoding="utf-8"?>
<!-- Endurecimiento de red:
     - cleartextTrafficPermitted="false" por defecto (la API es HTTPS).
     - cleartext SOLO para localhost / 10.0.2.2 (emulador y debug).
     - Solo se confían los certificados del sistema (nada de certificados
       de usuario: evita intercepción MITM). -->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">localhost</domain>
    <domain includeSubdomains="true">127.0.0.1</domain>
    <domain includeSubdomains="true">10.0.2.2</domain>
  </domain-config>
</network-security-config>
